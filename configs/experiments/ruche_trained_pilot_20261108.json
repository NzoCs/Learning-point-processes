  "neural_probe": "Existing trained NHP fixture, capability and cost only; no new real-dataset training or calibration claim",
  "real_data_gate": "Pin dataset revision and certify independent units and complete exposure before training/evaluation campaign; no invented exposure, first-event shifting or compatibility loading",
  "execution": {"max_concurrent_gpus": 4, "cuda_required": true, "exclude_nodes": ["ruche-gpu16"], "retries": 0}
