  ],
  "methods": [
    {"test_type": "window_mmd", "representation": "counting_grid", "sigma": 0.3, "n_samples": 499},
    {"test_type": "window_mmd", "representation": "counting_grid", "space_kernel_type": "linear", "n_samples": 499},
    {"test_type": "window_mmd", "representation": "intervals", "sigma": 0.3, "n_samples": 499},
    {"test_type": "window_mmd", "point_process_kernel": "count_rbf", "sigma": 1.0, "n_samples": 499},
